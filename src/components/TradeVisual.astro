---
interface Props {
  kind?: string;
  large?: boolean;
}
const { kind = 'industry', large = false } = Astro.props;
---

<div class:list={['trade-visual', kind, { large }]} aria-hidden="true">
  <svg
    viewBox="0 0 600 400"
    xmlns="http://www.w3.org/2000/svg"
    focusable="false"
  >
    <path
      d="M0 80H600M0 160H600M0 240H600M0 320H600M100 0V400M200 0V400M300 0V400M400 0V400M500 0V400"
      fill="none"
      stroke="currentColor"
      opacity=".09"
    />
    {kind === 'industry' ? (
      <g>
        <path
          d="M45 310H565M85 310V190L175 140V190L265 140V310M290 310V95H450V310"
          fill="none"
          stroke="currentColor"
          stroke-width="9"
        />
        <path
          d="M320 130H420M320 165H420M320 200H370"
          stroke="currentColor"
          stroke-width="8"
        />
        <circle
          cx="420"
          cy="262"
          r="65"
          fill="var(--visual-bg)"
          stroke="currentColor"
          stroke-width="10"
        />
        <circle
          cx="420"
          cy="262"
          r="27"
          fill="none"
          stroke="currentColor"
          stroke-width="9"
        />
        <path
          d="M420 182V204M420 320V342M340 262H362M478 262H500M362 204L379 221M461 303L478 320M362 320L379 303M461 221L478 204"
          stroke="currentColor"
          stroke-width="14"
        />
        <path
          d="M115 230H145M185 230H215"
          stroke="currentColor"
          stroke-width="13"
        />
      </g>
    ) : kind === 'transport' ? (
      <g>
        <path
          d="M55 325H550M85 280V120H350V280M350 175H445L505 235V280H450M350 280H200M85 280H130M375 195H435L475 235H375Z"
          fill="none"
          stroke="currentColor"
          stroke-width="9"
        />
        <circle
          cx="165"
          cy="282"
          r="34"
          fill="var(--visual-bg)"
          stroke="currentColor"
          stroke-width="9"
        />
        <circle
          cx="420"
          cy="282"
          r="34"
          fill="var(--visual-bg)"
          stroke="currentColor"
          stroke-width="9"
        />
        <path
          d="M120 160H310M120 195H260"
          stroke="currentColor"
          stroke-width="9"
        />
      </g>
    ) : (
      <g>
        <path
          d="M65 315H540M95 310V140H295V310M95 220H295M195 140V310M340 310V225H520V310M395 225V265H460V225M120 140V80H265V140M170 80V110H215V80"
          fill="none"
          stroke="currentColor"
          stroke-width="9"
        />
        <path
          d="M350 120H510M475 85L510 120L475 155"
          fill="none"
          stroke="currentColor"
          stroke-width="9"
          stroke-linecap="round"
        />
        <path
          d="M125 245H165M225 165H265"
          stroke="var(--visual-accent)"
          stroke-width="16"
        />
      </g>
    )}
  </svg>
  <span class="visual-caption">Illustration générique</span>
</div>
