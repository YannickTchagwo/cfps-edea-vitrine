---
import Layout from '../../layouts/Layout.astro';
import TradeVisual from '../../components/TradeVisual.astro';
import { formations } from '../../data/formations';
import { url } from '../../data/site';
export function getStaticPaths() {
  return formations.map((formation) => ({
    params: { slug: formation.slug },
    props: { formation },
  }));
}
const { formation: f } = Astro.props;
---

<Layout
  title={f.title}
  description={`${f.title} : objectifs et exemple de métier. Fiche de démonstration, formation non confirmée par le CFPS.`}
>
  <section class="page-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d’Ariane">
        <a href={url('')}>Accueil</a>
        <span aria-hidden="true">/</span>
        <a href={url('formations/')}>Formations</a>
        <span aria-hidden="true">/</span>
        <span>{f.title}</span>
      </nav>
      <p class="eyebrow">{f.domain}</p>
      <span class="demo-tag">Formation de démonstration</span>
      <h1>{f.title}</h1>
      <p>{f.summary}</p>
    </div>
  </section>
  <div class="container detail-layout">
    <article class="detail-main">
      <div class="notice">
        <strong>Exemple fictif pour découvrir le parcours.</strong> Cette fiche
        ne confirme ni l’ouverture de cette formation ni ses conditions d’accès.
        Les objectifs et métiers ci-dessous sont illustratifs.
      </div>
      <h2>Ce que vous pourriez apprendre</h2>
      <ul class="objective-list">
        {f.objectives.map((objective: string) => (
          <li>{objective}</li>
        ))}
      </ul>
      <h2>Prérequis</h2>
      <p>
        {f.prerequisites ||
          'Information à confirmer. Aucun niveau d’accès officiel n’a été transmis pour cet exemple.'}
      </p>
      <h2>Quels métiers envisager ?</h2>
      <ul>
        {f.careers.map((career: string) => (
          <li>{career}</li>
        ))}
      </ul>
      <p class="muted">
        Ces pistes illustratives ne constituent pas une promesse d’emploi.
      </p>
      <a class="text-link" href={url('formations/')}>
        <span aria-hidden="true">←</span> Retour au catalogue
      </a>
    </article>
    <aside class="detail-aside" aria-label="Repères de formation">
      <TradeVisual kind={f.illustration} />
      <div class="aside-body">
        <p class="eyebrow">LES REPÈRES</p>
        <dl>
          <dt>Domaine</dt>
          <dd>{f.domain}</dd>
          <dt>Durée</dt>
          <dd>{f.duration || 'À confirmer'}</dd>
          <dt>Lieu</dt>
          <dd>Édéa · campus à confirmer</dd>
        </dl>
        <p>Une question sur votre orientation ?</p>
        <a class="button" href={url('contact/')}>
          S’informer auprès du centre <span aria-hidden="true">↗</span>
        </a>
        <p class="muted">Le prototype ne reçoit aucune inscription.</p>
      </div>
    </aside>
  </div>
</Layout>
