---
import Layout from '../../layouts/Layout.astro';
import TradeVisual from '../../components/TradeVisual.astro';
import { formations, formationSource } from '../../data/formations';
import { url } from '../../data/site';
export function getStaticPaths() {
  return formations.map((formation) => ({
    params: { slug: formation.slug },
    props: { formation },
  }));
}
const { formation: f } = Astro.props;
---

<Layout
  title={f.title}
  description={`${f.title} : métier répertorié pour le CFPS d’Édéa, pôle ${f.domain}. Programme et conditions de formation à confirmer.`}
>
  <section class="page-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d’Ariane">
        <a href={url('')}>Accueil</a>
        <span aria-hidden="true">/</span>
        <a href={url('formations/')}>Métiers et formations</a>
        <span aria-hidden="true">/</span>
        <span>{f.title}</span>
      </nav>
      <p class="eyebrow">PÔLE {f.domain}</p>
      <span class="demo-tag source-tag">
        Métier répertorié dans le document
      </span>
      <h1>{f.title}</h1>
      <p>{f.summary}</p>
    </div>
  </section>
  <div class="container detail-layout">
    <article class="detail-main">
      <div class="notice">
        <strong>Intitulé et pôle issus de la liste transmise.</strong> Cette
        fiche reprend le métier indiqué pour Édéa. Le document ne confirme ni
        l’ouverture d’une session ni les conditions de formation.
      </div>
      <h2>Un métier du pôle {f.domain.toLocaleLowerCase('fr')}</h2>
      <p>
        « {f.title} » figure dans la rubrique CFPS, centre d’Édéa, au sein du
        pôle {f.domain.toLocaleLowerCase('fr')}.
      </p>
      <h2>Objectifs et programme</h2>
      {f.objectives ? (
        <ul class="objective-list">
          {f.objectives.map((objective) => (
            <li>{objective}</li>
          ))}
        </ul>
      ) : (
        <p>
          Information à confirmer. La liste des métiers ne détaille pas les
          objectifs pédagogiques, les modules ni les compétences visées.
        </p>
      )}
      <h2>Prérequis et accès à la formation</h2>
      <p>
        {f.prerequisites ||
          'Information à confirmer auprès du centre. Le niveau d’accès, les modalités de candidature et les possibilités de formation ne sont pas précisés dans le document transmis.'}
      </p>
      <h2>Source de cette fiche</h2>
      <p class="source-reference">
        {formationSource.title}, page {f.sourcePage} · rubrique CFPS, Édéa ·
        pôle {f.domain}.
      </p>
      <p class="muted">
        Document fourni pour adapter le prototype. Sa date et son organisme
        émetteur ne sont pas indiqués ; aucune validation institutionnelle
        supplémentaire n’est revendiquée.
      </p>
      <a class="text-link" href={url('formations/')}>
        <span aria-hidden="true">←</span> Retour au catalogue
      </a>
    </article>
    <aside class="detail-aside" aria-label="Repères du métier">
      <TradeVisual kind={f.illustration} />
      <div class="aside-body">
        <p class="eyebrow">LES REPÈRES</p>
        <dl>
          <dt>Pôle</dt>
          <dd>{f.domain}</dd>
          <dt>Centre</dt>
          <dd>CFPS d’Édéa</dd>
          <dt>Durée de formation</dt>
          <dd>{f.duration || 'À confirmer'}</dd>
        </dl>
        <p>Vous souhaitez vous former à ce métier ?</p>
        <a class="button" href={url('contact/')}>
          S’informer auprès du centre <span aria-hidden="true">↗</span>
        </a>
        <p class="muted">Le prototype ne reçoit aucune inscription.</p>
      </div>
    </aside>
  </div>
</Layout>
