---
import Layout from '../../layouts/Layout.astro';
import TradeVisual from '../../components/TradeVisual.astro';
import { formations, formationSource } from '../../data/formations';
import { url } from '../../data/site';
export function getStaticPaths() {
  return formations.map((formation) => ({
    params: { slug: formation.slug },
    props: { formation },
  }));
}
const { formation: f } = Astro.props;
const sections = [
  ['presentation', 'Présentation'],
  ['objectifs', 'Objectifs et compétences'],
  ['programme', 'Programme et pratique'],
  ['admission', 'Prérequis et admission'],
  ['perspectives', 'Débouchés professionnels'],
  ['source', 'Source et statut'],
];
const facts = [
  ['Centre', 'CFPS d’Édéa'],
  ['Pôle', f.domain],
  ['Durée de formation', f.duration],
  ['Qualification préparée', f.qualification],
  ['Conditions d’accès', f.prerequisites],
  ['Session / rentrée', f.session],
];
---

<Layout
  title={f.title}
  description={`${f.title} : présentation de la filière et repères de formation au CFPS d’Édéa. Pôle ${f.domain}. Conditions à confirmer.`}
>
  <section class="course-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d’Ariane">
        <a href={url('')}>Accueil</a>
        <span aria-hidden="true">/</span>
        <a href={url('formations/')}>Filières et métiers</a>
        <span aria-hidden="true">/</span>
        <span>{f.title}</span>
      </nav>
      <div class="course-hero-grid">
        <div class="course-hero-copy">
          <p class="eyebrow">PÔLE {f.domain}</p>
          <h1>{f.title}</h1>
          <p class="course-intro">{f.summary}</p>
          <span class="demo-tag source-tag">
            Métier répertorié dans le document
          </span>
        </div>
        <div class="course-hero-visual">
          <TradeVisual kind={f.illustration} />
        </div>
      </div>
    </div>
  </section>
  <div class="container course-layout">
    <article class="detail-main course-body">
      <details class="mobile-course-toc">
        <summary>Dans cette fiche</summary>
        <nav aria-label="Rubriques de la fiche">
          {sections.map(([id, label]) => (
            <a href={`#${id}`}>{label}</a>
          ))}
        </nav>
      </details>
      <section class="course-facts" aria-labelledby="facts-title">
        <p class="eyebrow">LES INFORMATIONS ESSENTIELLES</p>
        <h2 id="facts-title">La filière en bref</h2>
        <table class="facts-table">
          <caption class="sr-only">Repères de formation pour {f.title}</caption>
          <tbody>
            {facts.map(([label, value]) => (
              <tr>
                <th scope="row">{label}</th>
                <td>
                  {value || <span class="fact-pending">À confirmer</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="facts-note">
          Les intitulés et les pôles sont documentés. Les conditions de
          formation restent à confirmer auprès du centre.
        </p>
      </section>
      <section id="presentation" class="course-section">
        <h2>Présentation de la filière</h2>
        <p>
          « {f.title} » figure dans la rubrique CFPS, centre d’Édéa, au sein du
          pôle {f.domain.toLocaleLowerCase('fr')}.
        </p>
        <p>
          Cette fiche rassemble les repères pour préparer votre projet et les
          questions à poser au centre.
        </p>
      </section>
      <section id="objectifs" class="course-section">
        <h2>Objectifs et compétences</h2>
        {f.objectives ? (
          <ul class="objective-list">
            {f.objectives.map((objective) => (
              <li>{objective}</li>
            ))}
          </ul>
        ) : (
          <p>
            <strong class="section-pending">Information à confirmer.</strong>{' '}
            Les objectifs pédagogiques et les compétences visées ne sont pas
            détaillés dans la liste transmise. Ils seront présentés à partir du
            référentiel validé par le centre.
          </p>
        )}
      </section>
      <section id="programme" class="course-section">
        <h2>Programme et pratique professionnelle</h2>
        <p>
          <strong class="section-pending">Information à confirmer.</strong> Le
          programme, les modules, le volume horaire et la place des ateliers ou
          des périodes en entreprise ne sont pas précisés dans le document.
        </p>
        {f.modalities && <p>{f.modalities}</p>}
      </section>
      <section id="admission" class="course-section">
        <h2>Prérequis et admission</h2>
        <p>
          {f.prerequisites ||
            'Information à confirmer. Le niveau d’accès, les conditions de candidature et le calendrier doivent être vérifiés auprès du centre.'}
        </p>
        <a class="text-link" href={url('admissions/')}>
          Comprendre les démarches <span aria-hidden="true">↗</span>
        </a>
      </section>
      <section id="perspectives" class="course-section">
        <h2>Débouchés professionnels</h2>
        {f.careers ? (
          <ul>
            {f.careers.map((career) => (
              <li>{career}</li>
            ))}
          </ul>
        ) : (
          <p>
            <strong class="section-pending">Information à confirmer.</strong>{' '}
            Les débouchés, les secteurs d’activité et les éventuelles conditions
            d’exercice seront complétés avec les informations validées par le
            CFPS.
          </p>
        )}
      </section>
      <section id="source" class="course-section course-source">
        <h2>Source et statut de la fiche</h2>
        <p class="source-reference">
          {formationSource.title}, page {f.sourcePage} · rubrique CFPS, Édéa ·
          pôle {f.domain}.
        </p>
        <p class="muted">
          Le document répertorie le métier et son pôle. Il ne confirme pas
          l’ouverture d’une session. Sa date et son organisme émetteur ne sont
          pas indiqués ; aucune validation institutionnelle supplémentaire n’est
          revendiquée.
        </p>
      </section>
      <a class="text-link course-back" href={url('formations/')}>
        <span aria-hidden="true">←</span> Retour au catalogue
      </a>
    </article>
    <aside class="course-sidebar" aria-label="Navigation et orientation">
      <nav class="course-toc" aria-label="Dans cette fiche">
        <p class="eyebrow">DANS CETTE FICHE</p>
        {sections.map(([id, label], index) => (
          <a href={`#${id}`}>
            <span aria-hidden="true">0{index + 1}</span>
            {label}
          </a>
        ))}
      </nav>
      <div class="course-advice">
        <p class="eyebrow">VOTRE PROJET</p>
        <h2>Besoin d’un repère&nbsp;?</h2>
        <p>
          Préparez vos questions sur le programme et les conditions de
          formation.
        </p>
        <a class="button" href={url('contact/')}>
          S’informer auprès du centre <span aria-hidden="true">↗</span>
        </a>
        <p class="muted">Le prototype ne reçoit aucune inscription.</p>
      </div>
    </aside>
  </div>
</Layout>
