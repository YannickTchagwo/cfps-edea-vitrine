---
import Layout from '../layouts/Layout.astro';
import { url } from '../data/site';
import { pages } from '../data/pages';
export function getStaticPaths() {
  return Object.keys(pages).map((page) => ({ params: { page } }));
}
const page = pages[Astro.params.page as keyof typeof pages];
---

<Layout
  title={page.title}
  description={`${page.title} : ${page.intro} Informations du prototype CFPS d’Édéa à confirmer.`}
>
  <section class="page-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d’Ariane">
        <a href={url('')}>Accueil</a>
        <span aria-hidden="true">/</span>
        <span>{page.title}</span>
      </nav>
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
      <p>{page.intro}</p>
    </div>
  </section>
  <div class="container editorial">
    <div class="notice">
      Prototype d’information · Les contenus institutionnels et pratiques
      restent à valider par le CFPS.
    </div>
    {page.sections.map(([title, text]) => (
      <section>
        <h2>{title}</h2>
        <p>{text}</p>
      </section>
    ))}
    <div class="editorial-actions">
      <a class="button" href={url('formations/')}>
        Explorer le catalogue <span aria-hidden="true">↗</span>
      </a>
      {Astro.params.page !== 'contact' && (
        <a class="text-link" href={url('contact/')}>
          Informations de contact <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</Layout>
